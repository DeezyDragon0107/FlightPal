<article class="post">
	<div class="post-inner">
		<header class="post-title"><h2>TituloNoticia</h2></header>
		<div class="date">
			<blockquote class="post-date"><i class="fi fi-rs-earth-americas"> </i></blockquote>
			<p><i>20-01-2026</i></p>
		</div>
		
		<p class="post-content @(ShowText?"show":"")" @onclick="ShowAllText">
			Scelerisque euismod, iaculis eu lacus nunc mi elit, vehicula ut laoreet ac, aliquam sit amet justo nunc tempor, metus vel placerat suscipit, orci nisl iaculis eros, a tincidunt nisi odio eget lorem nulla condimentum tempor mattis ut vitae feugiat augue.
		</p>
	</div>
	
	<img class="post-image" src="/imgs/ccs2.jpeg" alt="Alternate Text" />

</article>

@code {
	bool ShowText { get; set; } = false;
	private async Task ShowAllText()
	{
		ShowText = !ShowText;
	}

}

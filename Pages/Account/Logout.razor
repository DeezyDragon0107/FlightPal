@page "/logout"
@inject AuthenticationStateProvider authStateProvider
@inject NavigationManager Navigation
@inject WelcomeService welcomeService
<div style="display: flex; flex-direction: column; min-height: 100vh; justify-content: center; align-items: center; text-align: center;">
	<img style="width: 256px; aspect-ratio: 1;" src="/imgs/avion_1.gif" alt="" />
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        var customProvider = (CustomAuthStateProvider)authStateProvider;
        await customProvider.UpdateAuthenticationState(null);
		welcomeService.GreetingDisplayed = true;
        Navigation.NavigateTo("/");
    }
}
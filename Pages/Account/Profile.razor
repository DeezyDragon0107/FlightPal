@rendermode InteractiveServer
@page "/Profile"
@inject IDatabaseConnection DatabaseConnection
@using ApexCharts
@using System.Timers
@using System.Globalization
@inject AuthenticationStateProvider authStateProvider
@inject NavigationManager navigationManager
@inject IJSRuntime JS

<PageTitle>Inicio</PageTitle>
@attribute [Authorize]
@layout Dashboard

<AuthorizeView Roles="ADMIN">
	<Authorized>
		
			<article class="principal-section">
				
			<section class="title-section">
				<div class="title-text">
					<h2>
						Bienvenido @(new CultureInfo("Es-es", false).TextInfo.ToTitleCase(context.User.Identity.Name.ToLower()))
					</h2>
					<p>Gestiona los usuarios y destinos desde el panel de administración</p>
				</div>
				<div class="image-title">
				</div>

			</section>



				<div class="cards">
				<StatCard Onclick="@(()=>navigationManager.NavigateTo("/admin/reports"))" Numero="Reportes" Nombre="Reportes" Style="cursor: pointer;" Color="rgba(16,185,129,.4)" IconColor="#095D4A"><i class="fi fi-sr-file-chart-line"></i></StatCard>
				<StatCard Nombre="Usuarios activos" Numero="@ActiveUsers.ToString()" Color="Aliceblue" IconColor="Blue">
					<i class="fi fi-br-users-alt"></i>
				</StatCard>
				<StatCard Nombre="Ingresos Totales" Numero="@(total.ToString() + "Bs")" Color="rgba(56, 176, 0, 0.1)" IconColor="#38b000">
					<i class="fi fi-br-dollar"></i>
				</StatCard>
				<StatCard Nombre="Todas las reservas" IconColor="#8338ec" Color="rgba(131, 56, 236, 0.1)" onclick="@(() => { MReservas = true; })" Numero="@((usuarioReservas.Count + usuarioPaquetes.Count).ToString())"><i class="fi fi-sr-reservation-table"></i></StatCard>
				</div>
			<div class="charts">

				<div class="chart-container">
					<ApexChart @key="chartKey1" Options="chartOptions" TItem="ReservasMes" Title="Reservas por mes">
						<ApexPointSeries TItem="ReservasMes"
										 Items="reservasMes"
										 SeriesType="@SeriesType.Area"
										 Name="Gross Value"
										 XValue="@(e =>  NombreMes(e.Mes))"
										 YValue="@(e => e.Total)" />
					</ApexChart>
				</div>
				<div class="chart-container">
					<ApexChart  @key="chartKey2" TItem="MostVisited" Title="Destinos visitados">
						<ApexPointSeries TItem="MostVisited"
										 Items="mosts"
										 SeriesType="@SeriesType.Donut"
										 Name="Gross Value"
										 XValue="@(e => e.Destino)"
										 YValue="@(e => e.Visitas)" />
					</ApexChart>
				</div>

			
			</div>
				<Modal Displayed="MReservas" DisplayedChanged="@(()=>MReservas=false)">


					
				<div class="tabs">

					<input type="radio" name="clase" checked="checked" id="Economica" value="1" />
					<label for="Economica">Reservas de vuelo</label>
					<div class="contenido">

							<div class="flight-table-container modal">
							<div class="table-inner">
								<table class="flight-table">
									<thead>
										<tr>
											<th>Nombre</th>
											<th>Apellido</th>
											<th>DNI</th>
											<th>Fecha de reserva</th>
											<th>Estado</th>
											<th>Metodo de Pago</th>
											<th>Numero Comprobante</th>
											<th>Total</th>
											<th>Acciones</th>
										</tr>
									</thead>
									<tbody>
										@if (usuarioReservas.Any())
										{
											foreach (var ur in usuarioReservas)
											{
												<tr>
													<td>@ur.Nombre</td>
													<td>@ur.Apellido</td>
													<td>
														@ur.Dni
													</td>
													<td>
														@ur.Fecha_reserva
													</td>

													<td><span class="status-badge @(ur.Estado == "PENDIENTE" ? "status-pending" : "") 
																		@(ur.Estado == "APROBADO" ? "status-active" : "")
																				@(ur.Estado == "RECHAZADO" ? "status-inactive" : "")">@ur.Estado</span>
													</td>

													<td>@ur.Metodo_pago</td>
													<td>@ur.Num_comprobante</td>
													<td>@ur.Monto_total Bs.</td>

													<td>
														<div class="table-actions">
		@* 
															<button class="action-btn approve" @onclick="@(() => UpdateReservas(ur, "APROBADO"))" title="Aprobar"><i class="fi fi-br-checkbox"></i></button>
															<button @onclick="@(() => VerComprobante(ur))" class="action-btn" title="Ver comprobante"><i class="fi fi-sr-credit-card-eye"></i></button>
															<button class="action-btn delete" @onclick="@(() => UpdateReservas(ur, "RECHAZADO"))" title="Rechazar"><i class="fi fi-br-vote-nay"></i></button> *@
														</div>
													</td>
												</tr>

											}
										}
									</tbody>
								</table>
							</div>

						</div>
					</div>

					<input type="radio" name="clase" id="paquetes" value="2" />
					<label for="paquetes">Reservas de paquetes</label>
					<div class="contenido">
						<div class="flight-table-container modal">
							<div class="table-inner">
								<table class="flight-table">
									<thead>
										<tr>
											<th>Cliente</th>
											<th>DNI</th>
											<th>Paquete</th>
											<th>Fecha de reserva</th>
											<th>Estado</th>
											<th>Metodo de Pago</th>
											<th>Numero Comprobante</th>
											<th>Total</th>
											<th>Acciones</th>
										</tr>
									</thead>
									<tbody>
										@if (usuarioPaquetes.Any())
										{
											foreach (var ur in usuarioPaquetes)
											{
												<tr>
													<td>@ur.Nombre @ur.Apellido</td>
													<td>
														@ur.Dni
													</td>
													<td>@(paquetes.Find(e => e.Id_Paquete == ur.Id_paquete).Nombre_paquete)</td>
													<td>
														@ur.Fecha
													</td>
													<td>
													<span class="status-badge @(ur.Estado == "PENDIENTE" ? "status-pending" : "")
																				@(ur.Estado == "APROBADO" ? "status-active" : "")
																						@(ur.Estado == "RECHAZADO" ? "status-inactive" : "")">@ur.Estado</span>
													</td>

													<td>@ur.Metodo_pago</td>
													<td>@ur.Numero_comprobante</td>
													<td>@ur.Monto_total Bs.</td>

													<td>
														<div class="table-actions">
															@if(ur.Estado == "PENDIENTE")
															{
																<button class="action-btn approve" @onclick="@(() => UpdateReservas(ur, "APROBADO"))" title="Aprobar"><i class="fi fi-br-checkbox"></i></button>
																<button @onclick="@(() => VerComprobante(ur))" class="action-btn" title="Ver comprobante"><i class="fi fi-sr-credit-card-eye"></i></button>
																<button class="action-btn delete" @onclick="@(() => UpdateReservas(ur, "RECHAZADO"))" title="Rechazar"><i class="fi fi-br-vote-nay"></i></button>
															}

														</div>
													</td>
												</tr>

											}
										}
									</tbody>
								</table>
							</div>

						</div>
					</div>
				</div>
				</Modal>
			</article>
	</Authorized>
</AuthorizeView>

<AuthorizeView Roles="USER">
	<Authorized>
		<section class="profile-principal">
			<article class="principal-section">
				<div class="banner">
					<h5>¿Aún no decides a donde viajar?</h5>
					<h3>Echa un vistazo a nuestra lista de destinos</h3>
				</div>
				<div class="widgets">
					<div class="widget-card">
						<span><i class="fi fi-br-bell"></i></span>
						<div class="widget-info">
							<h5>@Stats[0]</h5>
							<h4>Reservaciones activas</h4>
						</div>
					</div>
					<div class="widget-card">
						<span><i class="fi fi-sr-plane-alt"></i></span>
						<div class="widget-info">
							<h5>0</h5>
							<h4>Vuelos recientes</h4>
						</div>
					</div>
					<div class="widget-card">
						<span><i class="fi fi-br-usd-circle"></i></span>

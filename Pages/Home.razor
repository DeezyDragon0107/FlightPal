</section>


<section class="image-section anim-l">
	<img src="/imgs/pexels-quintingellar-313765.webp" alt="Alternate Text" />
	<h2>Alcanza nuevas alturas con FlightPal!</h2>

</section>

<AuthorizeView>
	<Authorized>
		<Modal Displayed="WelcomeService.GreetingDisplayed" DisplayedChanged="()=>CloseModalBienvenida()">
			<div class="greeting">
				<img src="/imgs/telefono-inteligente.gif" alt="" />
				<h3>Bienvenido @(
									new CultureInfo("Es-es", false).TextInfo.ToTitleCase(context.User?.Identity?.Name.ToLower())

				)</h3>
			</div>
			

		</Modal>
	</Authorized>
</AuthorizeView>




<Modal Displayed="@modal" DisplayedChanged="()=>CloseModal()">
	<City CityName=@CiudadActual></City>

</Modal>
@code{
	
	public bool? modalBienvenida { get; set; } = null;


	protected override Task OnInitializedAsync()
	{
		return base.OnInitializedAsync();
	}

	

	public async Task ShowModal(Ciudades c)
	{
		CiudadActual = (int)c;
		modal = true;
		StateHasChanged();
	}

	public async Task slide()
	{

		contador = (contador+1)%2;
		Console.WriteLine(contador);
		traslacion = $"-{contador*100}%";

	}

	public bool CloseModal()
	{

		modal = false;
		StateHasChanged();
		return modal;
	}

	public bool CloseModalBienvenida()
	{

		WelcomeService.GreetingDisplayed = false;
		StateHasChanged();
		return WelcomeService.GreetingDisplayed;
	}


	public enum Ciudades { Margarita, Caracas, Maracaibo }
	public bool modal { get; set; } = false;
	public int CiudadActual { get; set; }
	public string traslacion { get; set; } = "0";
	public int contador { get; set; } = 0;

	
}

@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@inject WelcomeService WelcomeService
@inject NavigationManager navigationManager
@using System.Globalization
<PageTitle>FlightPal</PageTitle>
<section class="animado">
	<video class="principal-banner" autoplay muted>
		<source src="/imgs/tiny.webm" type="video/webm" />
	</video>
	@* <img class="principal-banner" src="imgs\banner-4.jpg" alt="Alternate Text" style="width:100%; height: 100vh;" /> *@
	<div class="welcome-title">
		<h1>Descubre nuevas maneras de viajar por el mundo</h1>
		<h3>Compara precios de distintas aerolíneas, consigue boletos con un solo click. Reserva ahora</h3>
		

	</div>
	
</section>

<section class="sect2 anim-l">
	<div class="inf-container" style="padding: 30px;">
		<hgroup>
			<h2>Viaja ahora con FlightPal</h2>
			<h3> Con FlightPal tu destino soñado se encuentra a solo un click de distancia ¿Que estás esperando para registrarte en la agencia de viajes más innovadora de Venezuela?.</h3>
		</hgroup>
		

	</div>
	<div class="inf-container focused"style="padding: 30px;">
		<ul>
			<li>Reserva con un solo click</li>
			<li>Descarga tus boletos y accede prioritariamente a tu vuelo</li>
			<li>Gran cantidad de paquetes con multiples opciones de entretenimiento</li>
			<li>Todo lo que necesitas para iniciar tu viaje en una sola plataforma</li>
		</ul>

	</div>
</section>


<section class="info anim-r" >
	<header>
		<h2>Principales Destinos</h2>
	</header>

	<article class="cards-container">
		<div class="card">
			<img class="card-img" src="/imgs/mgta.webp" alt="Alternate Text" />
			
			<div class="card-info-container" @onclick="()=>ShowModal(Ciudades.Margarita)">
				<p>La perla del caribe</p>
				<h3>Margarita</h3>
			</div>
		</div>

		<div class="card">
			<img class="card-img" src="/imgs/Caracas.jpg" alt="Alternate Text" />
			
			<div class="card-info-container" @onclick="()=>ShowModal(Ciudades.Caracas)"> 
				<p>La capital del Pais, un destino imperdible</p>
				<h3>Caracas</h3>
			</div>
		</div>

		<div class="card">
			<img class="card-img" src="/imgs/mcbo.webp" alt="Alternate Text" />
			<div class="card-info-container" @onclick="()=>ShowModal(Ciudades.Maracaibo)">
				<p>Cuna de algunas de las más bellas tradiciones venezolanas</p>
				<h3>Maracaibo</h3>
				<p></p>
			</div>
		</div>
	</article>
</section>

<section class="second-banner anim-l">
	<img src="./imgs/baner3.jpg" alt="Alternate Text" />
	<video autoplay muted loop>
		<source  src="/imgs/tiny.webm" type="video/webm"/>
	</video>
	<div class="inf-card">
		<h2>No te pierdas las próximas ofertas de vuelo</h2>
		<h4>Mantente informado a traves de nuestro newspaper digital</h4>
		<button @onclick="@(()=>navigationManager.NavigateTo("login"))">Inscribete</button>
	</div>

</section>

